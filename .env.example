# Vercel's connected Neon resource sets DATABASE_URL automatically.
# DATABASE_URL=postgresql://...
# Optional alternative: connect a Turso database to the project through Storage.
# Server-only secrets: never add NEXT_PUBLIC_ prefixes or commit real values.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-database-token

# Optional locally when Turso is not configured. Defaults to data/handoff.sqlite.
# HANDOFF_DB_PATH=/persistent-data/handoff.sqlite
# Set the exact public origin when deploying behind an HTTPS reverse proxy.
# APP_ORIGIN=https://handoff.example.com

# Optional email verification. Set BOTH on Vercel to activate verification for new accounts.
# Verify the sending domain in Resend before using its From address.
# RESEND_API_KEY=re_...
# HANDOFF_EMAIL_FROM=Handoff <verify@your-domain.example>
